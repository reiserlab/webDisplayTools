{
  "configById": {
    "3D!arena": {
      "cameraState": {
        "perspective": true,
        "distance": 9,
        "phi": 58,
        "thetaOffset": 35,
        "targetOffset": [0, 0, 1.2],
        "target": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "fovy": 45,
        "near": 0.1,
        "far": 1000
      },
      "followMode": "follow-pose",
      "followTf": "arena",
      "scene": {
        "backgroundColor": "#0f1419",
        "enableStats": false,
        "transforms": { "showLabel": false, "axisScale": 0 }
      },
      "transforms": {},
      "topics": {
        "/viz/markers": { "visible": true }
      },
      "layers": {},
      "publish": {
        "type": "point",
        "poseTopic": "/move_base_simple/goal",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.5,
        "poseEstimateYDeviation": 0.5,
        "poseEstimateThetaDeviation": 0.26
      },
      "imageMode": {}
    },
    "Indicator!reachable": {
      "foxglovePanelTitle": "BIAS",
      "path": "/viz/bias/reachable.data",
      "style": "bulb",
      "fallbackColor": "#8b949e",
      "fallbackLabel": "no status",
      "rules": [
        { "operator": "=", "rawValue": "true", "color": "#00e676", "label": "reachable" },
        { "operator": "=", "rawValue": "false", "color": "#ff5252", "label": "unreachable" }
      ]
    },
    "Indicator!capturing": {
      "foxglovePanelTitle": "Camera",
      "path": "/viz/bias/capturing.data",
      "style": "bulb",
      "fallbackColor": "#8b949e",
      "fallbackLabel": "unknown",
      "rules": [
        { "operator": "=", "rawValue": "true", "color": "#00e676", "label": "capturing" },
        { "operator": "=", "rawValue": "false", "color": "#8b949e", "label": "idle" }
      ]
    },
    "Indicator!logging": {
      "foxglovePanelTitle": "Video",
      "path": "/viz/bias/logging.data",
      "style": "bulb",
      "fallbackColor": "#8b949e",
      "fallbackLabel": "unknown",
      "rules": [
        { "operator": "=", "rawValue": "true", "color": "#ffd740", "label": "writing" },
        { "operator": "=", "rawValue": "false", "color": "#8b949e", "label": "off" }
      ]
    },
    "Gauge!fps": {
      "foxglovePanelTitle": "Camera fps",
      "path": "/viz/bias/fps.data",
      "minValue": 0,
      "maxValue": 200,
      "colorMap": "red-yellow-green",
      "colorMode": "colormap",
      "gradient": ["#0000ff", "#ff00ff"],
      "reverse": false
    },
    "StateTransitions!biasstate": {
      "paths": [
        { "value": "/viz/bias/state.data", "timestampMethod": "receiveTime", "label": "BIAS" }
      ],
      "isSynced": true
    },
    "Plot!frames": {
      "title": "BIAS camera frames",
      "paths": [
        { "value": "/viz/bias/frame_count.data", "enabled": true, "timestampMethod": "receiveTime", "label": "camera frames" }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 240,
      "followingViewWidth": 60
    },
    "Plot!arenaindex": {
      "title": "Displayed frame index",
      "paths": [
        { "value": "/viz/arena/index.data", "enabled": true, "timestampMethod": "receiveTime", "label": "frame index" }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 240,
      "followingViewWidth": 60
    },
    "RawMessages!reply": {
      "topicPath": "/bias/reply",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "DiagnosticSummary!health": {
      "minLevel": 0,
      "pinnedIds": [],
      "hardwareIdFilter": "",
      "topicToRender": "/diagnostics",
      "sortByLevel": true
    },
    "DiagnosticStatusPanel!detail": {
      "topicToRender": "/diagnostics",
      "collapsedSections": []
    },
    "RawMessages!lasterror": {
      "topicPath": "/viz/last_error",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "RosOut!log": {
      "foxglovePanelTitle": "ROS log (live only: bags do not record /rosout)",
      "searchTerms": [],
      "minLogLevel": 2,
      "nameFilter": {}
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "direction": "row",
    "splitPercentage": 62,
    "first": {
      "direction": "column",
      "splitPercentage": 48,
      "first": "3D!arena",
      "second": {
        "direction": "column",
        "splitPercentage": 30,
        "first": "StateTransitions!biasstate",
        "second": {
          "direction": "row",
          "splitPercentage": 55,
          "first": {
            "direction": "column",
            "splitPercentage": 55,
            "first": "Plot!frames",
            "second": "Plot!arenaindex"
          },
          "second": "RawMessages!reply"
        }
      }
    },
    "second": {
      "direction": "column",
      "splitPercentage": 28,
      "first": {
        "direction": "row",
        "splitPercentage": 66,
        "first": {
          "direction": "row",
          "splitPercentage": 50,
          "first": "Indicator!reachable",
          "second": {
            "direction": "column",
            "splitPercentage": 50,
            "first": "Indicator!capturing",
            "second": "Indicator!logging"
          }
        },
        "second": "Gauge!fps"
      },
      "second": {
        "direction": "column",
        "splitPercentage": 40,
        "first": "DiagnosticSummary!health",
        "second": {
          "direction": "column",
          "splitPercentage": 55,
          "first": "DiagnosticStatusPanel!detail",
          "second": {
            "direction": "column",
            "splitPercentage": 40,
            "first": "RawMessages!lasterror",
            "second": "RosOut!log"
          }
        }
      }
    }
  }
}
