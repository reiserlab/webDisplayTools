{
  "configById": {
    "3D!arena": {
      "cameraState": {
        "perspective": true,
        "distance": 9,
        "phi": 58,
        "thetaOffset": 35,
        "targetOffset": [0, 0, 1.2],
        "target": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "fovy": 45,
        "near": 0.1,
        "far": 1000
      },
      "followMode": "follow-pose",
      "followTf": "arena",
      "scene": {
        "backgroundColor": "#0f1419",
        "enableStats": false,
        "transforms": { "showLabel": false, "axisScale": 0 }
      },
      "transforms": {},
      "topics": {
        "/viz/markers": { "visible": true }
      },
      "layers": {},
      "publish": {
        "type": "point",
        "poseTopic": "/move_base_simple/goal",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.5,
        "poseEstimateYDeviation": 0.5,
        "poseEstimateThetaDeviation": 0.26
      },
      "imageMode": {}
    },
    "Plot!closedloop": {
      "title": "Closed loop: fly vs display",
      "paths": [
        { "value": "/viz/fictrac/turn_deg.data", "enabled": true, "timestampMethod": "receiveTime", "label": "fly turn (deg, unwrapped)" },
        { "value": "/viz/arena/azimuth_deg.data", "enabled": true, "timestampMethod": "receiveTime", "label": "feature azimuth (deg, right +)" },
        { "value": "/viz/arena/bias_deg.data", "enabled": true, "timestampMethod": "receiveTime", "label": "bias angle (deg)" }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 240,
      "followingViewWidth": 30
    },
    "Plot!kinematics": {
      "title": "FicTrac kinematics",
      "paths": [
        { "value": "/viz/fictrac/speed_dps.data", "enabled": true, "timestampMethod": "receiveTime", "label": "speed (deg/s)" },
        { "value": "/viz/fictrac/fwd_rad.data", "enabled": true, "timestampMethod": "receiveTime", "label": "forward (rad, integrated)" },
        { "value": "/viz/fictrac/side_rad.data", "enabled": true, "timestampMethod": "receiveTime", "label": "side (rad, integrated)" }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 240,
      "followingViewWidth": 30
    },
    "Plot!index": {
      "title": "Displayed frame index",
      "paths": [
        { "value": "/viz/arena/index.data", "enabled": true, "timestampMethod": "receiveTime", "label": "frame index" }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": false,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    },
    "DiagnosticSummary!health": {
      "minLevel": 0,
      "pinnedIds": [],
      "hardwareIdFilter": "",
      "topicToRender": "/diagnostics",
      "sortByLevel": true
    },
    "DiagnosticStatusPanel!detail": {
      "topicToRender": "/diagnostics",
      "collapsedSections": []
    },
    "Gauge!ftrate": {
      "path": "/viz/fictrac/rate_hz.data",
      "minValue": 0,
      "maxValue": 120,
      "colorMap": "red-yellow-green",
      "colorMode": "colormap",
      "gradient": ["#0000ff", "#ff00ff"],
      "reverse": false
    },
    "Indicator!fictrac": {
      "path": "/viz/fictrac/rate_hz.data",
      "style": "bulb",
      "fallbackColor": "#8b949e",
      "fallbackLabel": "FicTrac: no data",
      "rules": [
        { "operator": ">", "rawValue": "5", "color": "#00e676", "label": "FicTrac flowing" },
        { "operator": "<=", "rawValue": "5", "color": "#ff5252", "label": "FicTrac stalled" }
      ]
    },
    "RawMessages!lasterror": {
      "topicPath": "/viz/last_error",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "RosOut!log": {
      "searchTerms": [],
      "minLogLevel": 2,
      "nameFilter": {}
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "direction": "row",
    "splitPercentage": 66,
    "first": {
      "direction": "column",
      "splitPercentage": 50,
      "first": "3D!arena",
      "second": {
        "direction": "column",
        "splitPercentage": 55,
        "first": "Plot!closedloop",
        "second": {
          "direction": "row",
          "splitPercentage": 60,
          "first": "Plot!kinematics",
          "second": "Plot!index"
        }
      }
    },
    "second": {
      "direction": "column",
      "splitPercentage": 22,
      "first": {
        "direction": "row",
        "splitPercentage": 50,
        "first": "Indicator!fictrac",
        "second": "Gauge!ftrate"
      },
      "second": {
        "direction": "column",
        "splitPercentage": 40,
        "first": "DiagnosticSummary!health",
        "second": {
          "direction": "column",
          "splitPercentage": 55,
          "first": "DiagnosticStatusPanel!detail",
          "second": {
            "direction": "column",
            "splitPercentage": 40,
            "first": "RawMessages!lasterror",
            "second": "RosOut!log"
          }
        }
      }
    }
  }
}
