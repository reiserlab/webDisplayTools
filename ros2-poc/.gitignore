# pixi environment for this workspace (pixi.toml + pixi.lock are tracked)
.pixi/*
!.pixi/config.toml
__pycache__/
*.pyc
# bridge-node run logs land here by default
runlogs/
*.jsonl
*.jsonl.gz
# ...except the recorded test fixtures (okey_smoke_violet_cw.jsonl.gz was silently ignored before 2026-10-22)
!tests/fixtures/*.jsonl.gz
# colcon alternative build of interfaces/arena_interfaces (pixi-build is the primary route)
interfaces/build/
interfaces/install/
interfaces/build.log
interfaces/build-result.json
# colcon build logs (never commit)
interfaces/log/
# the one-off win-64 channel payload lives at commit 3051258 (pixi.toml pins that URL); not in the tree
channel/noarch/
channel/win-64/
