{
  "configById": {
    "3D!arena": {
      "foxglovePanelTitle": "Fly, ball and pattern",
      "cameraState": {
        "perspective": true,
        "distance": 9,
        "phi": 58,
        "thetaOffset": 35,
        "targetOffset": [
          0,
          0,
          1.2
        ],
        "target": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45,
        "near": 0.1,
        "far": 1000
      },
      "followMode": "follow-pose",
      "followTf": "arena",
      "scene": {
        "backgroundColor": "#0f1419",
        "enableStats": false,
        "transforms": {
          "showLabel": false,
          "axisScale": 0
        }
      },
      "transforms": {},
      "topics": {
        "/viz/markers": {
          "visible": true
        }
      },
      "layers": {},
      "imageMode": {}
    },
    "Image!camera": {
      "foxglovePanelTitle": "Camera",
      "imageMode": {
        "imageTopic": "/camera/image"
      }
    },
    "Tab!view": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "Arena",
          "layout": "3D!arena"
        },
        {
          "title": "Camera",
          "layout": "Image!camera"
        }
      ]
    },
    "Image!display": {
      "foxglovePanelTitle": "Arena display (commanded)",
      "imageMode": {
        "imageTopic": "/arena/display"
      }
    },
    "Image!observed": {
      "foxglovePanelTitle": "Arena display (controller-reported)",
      "imageMode": {
        "imageTopic": "/arena/display_observed"
      }
    },
    "Tab!display": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "Display",
          "layout": "Image!display"
        },
        {
          "title": "Observed",
          "layout": "Image!observed"
        }
      ]
    },
    "Indicator!fictrac": {
      "foxglovePanelTitle": "FicTrac",
      "path": "/viz/fictrac/rate_hz.data",
      "style": "background",
      "fallbackColor": "#8b949e",
      "fallbackLabel": "no data",
      "rules": [
        {
          "operator": ">",
          "rawValue": "5",
          "color": "#009E73",
          "label": "tracking"
        },
        {
          "operator": "<=",
          "rawValue": "5",
          "color": "#D55E00",
          "label": "stalled"
        }
      ]
    },
    "Indicator!arena": {
      "foxglovePanelTitle": "Arena",
      "path": "/viz/arena/ok.data",
      "style": "background",
      "fallbackColor": "#8b949e",
      "fallbackLabel": "no data",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#009E73",
          "label": "on schedule"
        },
        {
          "operator": "=",
          "rawValue": "false",
          "color": "#E69F00",
          "label": "check"
        }
      ]
    },
    "Indicator!camera": {
      "foxglovePanelTitle": "Camera",
      "path": "/viz/bias/state.data",
      "style": "background",
      "fallbackColor": "#8b949e",
      "fallbackLabel": "no data",
      "rules": [
        {
          "operator": "=",
          "rawValue": "recording",
          "color": "#009E73",
          "label": "recording"
        },
        {
          "operator": "=",
          "rawValue": "preview",
          "color": "#E69F00",
          "label": "preview"
        },
        {
          "operator": "=",
          "rawValue": "idle",
          "color": "#E69F00",
          "label": "idle"
        },
        {
          "operator": "=",
          "rawValue": "unreachable",
          "color": "#D55E00",
          "label": "unreachable"
        }
      ]
    },
    "StateTransitions!run": {
      "foxglovePanelTitle": "Trial",
      "paths": [
        {
          "value": "/viz/arena/condition.data",
          "timestampMethod": "receiveTime",
          "label": "condition"
        },
        {
          "value": "/viz/arena/state.data",
          "timestampMethod": "receiveTime",
          "label": "arena"
        },
        {
          "value": "/viz/bias/state.data",
          "timestampMethod": "receiveTime",
          "label": "camera"
        }
      ],
      "isSynced": true
    },
    "Plot!position": {
      "foxglovePanelTitle": "Pattern position in the fly's view (deg)",
      "paths": [
        {
          "value": "/viz/arena/azimuth_deg.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "pattern azimuth",
          "color": "#E69F00",
          "showLine": false
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": false,
      "legendDisplay": "top",
      "showPlotValuesInLegend": false,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 60,
      "minYValue": -180,
      "maxYValue": 180
    },
    "Plot!turning": {
      "foxglovePanelTitle": "Turning (deg/s)",
